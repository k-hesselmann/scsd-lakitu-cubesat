# environments
venv/
.venv/
__pycache__/
*.pyc

# datasets — large, never committed (see README)
payload/data/*
!payload/data/.gitkeep

# model artifacts — intermediate; the deployment model is tracked in coral/models/
payload/models/*
!payload/models/.gitkeep
*.tflite
!payload/coral/models/*_edgetpu.tflite
*.h5
*.keras

# raw imagery
*.TIF
*.tif
*.zip

# edge-tpu compile logs
*_edgetpu.log

# notebook noise
.ipynb_checkpoints/

# STM32CubeIDE / Eclipse workspace cache (not the project itself)
.metadata/

# LaTeX build artifacts
Final_Report/*.aux
Final_Report/*.log
Final_Report/*.out
Final_Report/*.toc
Final_Report/*.fls
Final_Report/*.fdb_latexmk
Final_Report/*.synctex.gz
Final_Report/*.pdf
Final_Report/chapters/*.aux
